# --- Generation (fal.ai) ---
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# --- Show director (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Chat ingest ---
# Twitch channel to read suggestions from (anonymous read, no token needed)
TWITCH_CHANNEL=
# YouTube Data API key + live video id: read an (unlisted) broadcast's chat
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=

# --- Self-hosted platform (npm run serve) ---
# Bearer token for POST /start and /stop
CONTROL_TOKEN=
# Shared link token for the viewer page: /?key=<VIEWER_TOKEN>
VIEWER_TOKEN=

# --- Spend guards (estimated, conservative) ---
# Per-episode cap in USD (default 5; 0 = uncapped). Full quality ≈ $4.80/min.
EPISODE_BUDGET_USD=
# Per-UTC-day cap across all episodes (default 25; 0 = uncapped). Persisted under DATA_DIR/spend.
DAILY_BUDGET_USD=

# Output-side content screen (Haiku reads the director's riff + scene prompt before generation). "off" disables.
OUTPUT_SCREEN=

# --- Recordings ---
# Where created shows, state, spend ledger and episode recordings live (default data/; /data on Railway).
DATA_DIR=
# Archive size cap in GB (default 2) and free-disk headroom required to start an episode (default 1).
ARCHIVE_MAX_GB=
MIN_FREE_GB=

# --- Playout ---
# RTMP ingest URL including stream key, e.g.
#   rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx
#   rtmp://live.twitch.tv/app/live_xxxxxxxx
# Leave empty to write the episode to a local file instead of streaming.
RTMP_URL=

# --- Tilly identity references (used by H3 Max reference-to-video) ---
# Comma-separated public URLs of 1-4 reference stills of Tilly (subject consistency).
TILLY_REFERENCE_IMAGE_URLS=
# Public URL of a 5-15s clip of Tilly's voice (voice consistency across clips).
TILLY_REFERENCE_AUDIO_URL=
